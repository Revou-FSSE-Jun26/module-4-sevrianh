FLASK_APP=app:create_app
FLASK_DEBUG=1
# Hosted databases need sslmode=require, e.g. postgresql://user:password@host:5432/sevy?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/sevy
# Used only by pytest; must end in _test (conftest refuses to truncate any other database)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/sevy_test
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated exact origins; never use *
CORS_ORIGINS=http://localhost:3000
